@{ ViewData["title"] = "Vai trò và quyền"; }
<div class="card"><div class="card-body"><h4>Vai trò và quyền</h4>
<p>SuperUser: quản trị; HR.Personnel.Manage: quản lý tài khoản và đơn vị; HR.Personnel.View: chỉ xem.
Nhân viên tạo yêu cầu; quyền xử lý được kiểm tra theo người được phân công trong snapshot. Gán vai trò tại Quản lý tài khoản.</p>
<div id="rolesGrid"></div></div></div>
@section Scripts {
<script>
$(function () {
    let rows = [];
    async function save(id, data) {
        const r = await fetch('/api/admin/roles' + (id ? '/' + id : ''), {
            method: id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
        });
        if (!r.ok) throw new Error(await r.text());
    }
    $('#rolesGrid').dxDataGrid({
        dataSource: new DevExpress.data.CustomStore({ key: 'id',
            load: async () => rows = await fetch('/api/admin/roles').then(r => r.json()),
            insert: values => save(null, values),
            update: (id, values) => save(id, { ...rows.find(r => r.id === id), ...values })
        }),
        editing: { mode: 'popup', allowAdding: true, allowUpdating: true },
        showBorders: true,
        columns: [{ dataField: 'name', caption: 'Mã vai trò', validationRules: [{ type: 'required' }] },
                  { dataField: 'displayName', caption: 'Tên hiển thị', validationRules: [{ type: 'required' }] }]
    });
});
</script>
}
