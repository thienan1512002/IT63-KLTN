@{
    ViewData["ResetPasswordAlert"] = TempData["ResetPasswordAlert"];
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var devExtremeLicenseKey = System.Environment.GetEnvironmentVariable("DEVEXTREME_LICENSE_KEY");
    string currentFlag;
    string currentLanguageName;
    if (string.Equals(currentCulture, "en-US", StringComparison.OrdinalIgnoreCase))
    {
        currentFlag = Url.Content("~/images/flag/united-kingdom.png");
        currentLanguageName = "ENG";
    }
    else
    {
        currentFlag = Url.Content("~/images/flag/vietnam.png");
        currentLanguageName = "VNI";
    }

}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
