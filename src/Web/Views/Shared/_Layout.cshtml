<body>
    <div class="container-scroller">
        <!-- partial:partials/_navbar.html -->
        <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a class="navbar-brand brand-logo nvu-navbar-brand" href="/" aria-label="@Lang.GetKey("brand_university")">
                    <partial name="Partials/_UniversityBrand" />
                </a>
                <a class="navbar-brand brand-logo-mini nvu-navbar-brand" href="/" aria-label="@Lang.GetKey("brand_university")">
                    <img src="~/images/branding/nam-viet-mark.png" asp-append-version="true" alt="" width="38" height="38" />
                </a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="icon-menu"></span>
                </button>
                <ul class="navbar-nav mr-lg-2">
                    <li class="nav-item nav-search d-none d-lg-block">
                        <div class="input-group input-group-sm flex-nowrap">
                            <div class="input-group-prepend hover-cursor" id="navbar-search-icon">
                                <span class="input-group-text" id="search">
                                    <i class="icon-search" style="font-size: 18px;"></i>
                                </span>
                            </div>
                            <input type="text" class="form-control" maxlength="60" id="navbar-search-input"
                                   placeholder="@Lang.GetKey("user_search_emp")" aria-label="search"
                                   aria-describedby="search" style="width: 300px;">
                            <button style="display: none;" data-target="#modalSearch" data-toggle="modal" id="aSearch"
                                    href="#modalSearch">
                                a
                            </button>
                            <button style="display: none;" data-target="#searchEmpty" data-toggle="modal" id="aEmpty"
                                    href="#searchEmpty">
                                b
                            </button>
                        </div>
                    </li>
                </ul>
                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" id="langDropdown" href="#" data-toggle="dropdown">
                            <img src="@currentFlag" height="32" width="32" alt="@currentCulture" class="align-middle" />
                            <span class="ml-1 align-middle">@currentLanguageName</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="langDropdown">
                            <a class="dropdown-item" asp-action="SetLanguage" asp-controller="home"
                               asp-route-culture="en-US" asp-route-returnUrl="@currentUrl">
                                <img src="~/images/flag/united-kingdom.png" height="32" /> &nbsp;&nbsp;
                                ENG
                            </a>
                            <a class="dropdown-item" asp-action="SetLanguage" asp-controller="home"
                               asp-route-culture="vi-VN" asp-route-returnUrl="@currentUrl">
                                <img src="~/images/flag/vietnam.png" height="32" />&nbsp;&nbsp;
                                VNI
                            </a>
                        </div>
                    </li>
                    <div id="google_translate_element" style="margin-top: 14px;"></div>
                    <li class="nav-item dropdown">
                        <a class="nav-link count-indicator dropdown-toggle" id="notificationDropdown" href="#"
                           data-toggle="dropdown">
                            <i class="icon-bell mx-0"></i>
                            @* <span class="count"></span> *@
                            <span class="badge badge-primary" id="countNoti"
                                  style="position:absolute; margin-left:-10px; padding:3px 4.8px"></span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list"
                             aria-labelledby="notificationDropdown" id="notificationDropdown1">
                            <p class="mb-0 font-weight-normal float-left dropdown-header">@Lang.GetKey("noti_page_title")</p>
                            <p class="mb-0 text-primary float-right dropdown-header" style="cursor:pointer"
                               id="clearNotiAll">
                                @Lang.GetKey("noti_clear_all")
                            </p>
                        </div>
                    </li>
                    <li class="nav-item">
                        <p style="margin-top:10px; font-size:0.75rem">@User.Identity.Name</p>
                    </li>
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown" id="profileDropdown"
                           style="position: relative">
                            <img src="" alt="profile" id="avtImg" />
                            <div id='online-status'> </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown"
                             aria-labelledby="profileDropdown">
                            <a class="dropdown-item" asp-action="Setting" asp-controller="User">
                                <i class="ti-settings text-primary"></i>
                                @Lang.GetKey("common_setting")
                            </a>
                            <form asp-action="Logout" asp-controller="Account" method="post"><button type="submit" class="dropdown-item">
                                <i class="ti-power-off text-primary"></i>
                                @Lang.GetKey("common_logout")
                            </button></form>
                        </div>
                    </li>
                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button"
                        data-toggle="offcanvas">
                    <span class="icon-menu"></span>
                </button>
            </div>
        </nav>
        <!-- partial -->
        <div class="container-fluid page-body-wrapper">
            <!-- partial -->
            <!-- partial:partials/_sidebar.html -->
            @* <partial name="/Views/Shared/Partials/_Sidebar.cshtml" /> *@
            <partial name="/Views/Shared/Partials/_SidebarHierarchy.cshtml" />
            <!-- partial -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <!-- content-wrapper ends -->
                @* modal search employee information *@
                <div class="modal" id="modalSearch" tabindex="-1" role="dialog">
                    <div class="modal-dialog modal-xl" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Search Result</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="row" id="resultDiv">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal"
                                        onclick="return closeSearch()">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                @* modal search Empty *@
                <div class="modal fade" id="searchEmpty" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
                     aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Search result</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Không tìm thấy kết quả cho "<span id="searchText"></span>"
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal"
                                        onclick="return closeSearch()">
                                    Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- partial:partials/_footer.html -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">
                            © @DateTime.Today.Year — Hệ thống phê duyệt yêu cầu tự động.
                    </span>
                </div>
            </footer>
            <!-- partial -->
        </div>
        <!-- main-panel ends -->
    </div>
    <!-- page-body-wrapper ends -->
</div>
<!-- container-scroller -->
