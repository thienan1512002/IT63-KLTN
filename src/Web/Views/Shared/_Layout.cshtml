<link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

<script>
    window.layoutConfig = {
    culture: "@currentCulture"
    };
    Object.assign(window.i18n = window.i18n || {}, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        userName = Lang.GetKey("user_emp_name"),
        fullName = Lang.GetKey("user_emp_fullName"),
        email = Lang.GetKey("user_emp_email"),
        phone = Lang.GetKey("user_emp_phone"),
        dob = Lang.GetKey("user_emp_dob"),
        department = Lang.GetKey("common_department"),
        section = Lang.GetKey("common_section"),
        position = Lang.GetKey("user_emp_position"),
        site = Lang.GetKey("common_site"),
        upload = new
        {
            invalidFilesTitle = Lang.GetKey("upload_invalid_files_title"),
            invalidClipboardFilesTitle = Lang.GetKey("upload_invalid_clipboard_files_title"),
            emptyFile = Lang.GetKey("upload_empty_file"),
            unnamedFile = Lang.GetKey("upload_unnamed_file"),
            fileTooLarge = Lang.GetKey("upload_file_too_large"),
            unsupportedType = Lang.GetKey("upload_unsupported_type"),
            invalidFile = Lang.GetKey("upload_invalid_file"),
            maxFilesExceeded = Lang.GetKey("upload_max_files_exceeded")
        },
    })));
</script>
<script src="~/js/common/layout.js" asp-append-version="true"></script>
<script src="~/js/workflow/pending-approvals-badge.js" asp-append-version="true"></script>
<script src="~/js/common/security.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
