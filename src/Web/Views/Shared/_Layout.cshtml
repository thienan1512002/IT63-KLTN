@if (!string.IsNullOrWhiteSpace(devExtremeLicenseKey))
{
    <script>
        DevExpress.config({
            licenseKey: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(devExtremeLicenseKey))
        });
    </script>
}
<script src="~/layout_assets/devextreme/localization/dx.messages.en.js"></script>
<script src="~/layout_assets/devextreme/localization/dx.messages.vi.js"></script>

<script>
    (function () {     
        var culture = "@currentCulture";
        var isVi = culture.toLowerCase().indexOf("vi") === 0;
        // Override decimal number format   
        var Original = window.Intl && Intl.NumberFormat;
        if (isVi && Original) {
            Intl.NumberFormat = function (locales, options) {
                var loc = locales;
                if (typeof loc === "string" && loc.toLowerCase().indexOf("vi") === 0) {
                    loc = "en-US";
                }
                return new Original(loc, options);
            };
            Intl.NumberFormat.prototype = Original.prototype;
            Intl.NumberFormat.supportedLocalesOf = Original.supportedLocalesOf.bind(Original);
        }       
      
        var dxLocale = culture.toLowerCase().indexOf("vi") === 0 ? "vi" : "en";
        if (window.DevExpress && DevExpress.localization) {
            DevExpress.localization.locale(dxLocale);
        }

    })();
</script>

<script src="~/layout_assets/highcharts/highcharts.js"></script>
<script src="~/layout_assets/highcharts/accessibility.js"></script>
<!--Excel parse to js object-->
<script src="~/layout_assets/js/xlsx.full.min.js"></script>
