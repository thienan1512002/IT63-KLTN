    <style>
        #notificationDropdown1 {
        max-height: 330px;
        overflow-y: scroll;
        }

        .goog-te-banner-frame.skiptranslate {
        display: none !important;
        }

        div.goog-te-gadget {
        color: transparent !important;
        }

        #google_translate_element a {
        display: none;
        }

        body {
        top: 0px !important;
        }

        /*#truncateLongTexts {
        width: 335px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        }*/
        .content-wrapper,
        .card .card-body {
        padding: 1rem;
        }

        /* .content-wrapper,
        .footer
        {
        background: #fff;
        } */


        @@media only screen and (max-width:576px) {

        .content-wrapper,
        .card .card-body {
        padding: 0.5rem;
        }
        }

        #online-status {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        border: 2px solid white;
        bottom: 5px;
        right: 0;
        position: absolute;
        }

