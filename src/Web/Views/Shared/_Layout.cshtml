<!-- Modal -->
<div class="modal fade" id="accessModal" tabindex="-1" role="dialog" aria-labelledby="accessModalLabel"
     aria-hidden="true" style="overflow-y: hidden;">
    <div class="modal-dialog modal-dialog-centered mt-0" role="document">
        <div class="modal-content" style="overflow-y: hidden; max-height:400px;">
            <div class="modal-header d-flex justify-content-center align-items-center"
                 style="padding: 15px; background-color: #F5B184">
                <h3 class="modal-title text-light font-weight-bold" id="accessModalLabel">Notice</h3>
            </div>
            <div class="modal-body d-flex justify-content-center align-items-center flex-column">
                <span class="mdi mdi-alert-circle"
                      style="color: #F5B184; font-size: 120px; width: 120px; height:120px"></span>
                <span class="font-weight-bold text-center" style="margin-top: 10px; font-size:18px">
                    You do not have permission to access this function!
                </span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" style="width:90px; height:45px;"
                        data-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<!-- partial: resetPasswordAlert-->
