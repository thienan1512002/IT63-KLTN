@{
    ViewData["Title"] = Lang.GetKey("not_access_title");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .not-access-page {
        min-height: calc(100vh - 140px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
    }

    .not-access-card {
        width: 100%;
        max-width: 820px;
        text-align: center;
        background: #ffffff;
        border-radius: 26px;
        padding: 40px 38px 36px;
        box-shadow: 0 18px 45px rgba(45, 55, 95, 0.08);
        border: 1px solid rgba(120, 130, 180, 0.12);
    }

    .not-access-image-wrap {
        width: 100%;
        max-width: 560px;
        margin: 0 auto 20px;
    }

    .not-access-image {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
    }

    .not-access-title {
        font-size: 30px;
        font-weight: 700;
        color: #26324d;
        margin-bottom: 10px;
    }

    .not-access-message {
        font-size: 16px;
        color: #6b7280;
        margin-bottom: 26px;
        line-height: 1.6;
    }

    .not-access-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-soft-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 135px;
        height: 42px;
        padding: 0 18px;
        border-radius: 999px;
        background: #4f46e5;
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease;
    }

    .btn-soft-primary:hover {
        background: #4338ca;
        color: #ffffff;
        transform: translateY(-1px);
        text-decoration: none;
    }

    .btn-soft-light {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 135px;
        height: 42px;
        padding: 0 18px;
        border-radius: 999px;
        background: #f3f5ff;
        color: #4f5f82;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #e4e8ff;
        transition: all 0.2s ease;
    }

    .btn-soft-light:hover {
        background: #e9edff;
        color: #33415f;
        text-decoration: none;
    }

    .not-access-note {
        margin-top: 22px;
        font-size: 13px;
        color: #9ca3af;
    }

    @@media (max-width: 576px) {
        .not-access-page {
            padding: 24px 12px;
        }

        .not-access-card {
            padding: 30px 20px;
            border-radius: 22px;
        }

        .not-access-image-wrap {
            max-width: 100%;
            margin-bottom: 16px;
        }

        .not-access-title {
            font-size: 24px;
        }

        .not-access-message {
            font-size: 15px;
        }
    }
</style>

<div class="not-access-page">
    <div class="not-access-card">
        <div class="not-access-image-wrap">
            <img src="~/layout_assets/images/not-access-employee.png" alt="Access permission required"
                 class="not-access-image" />
        </div>

        <h1 class="not-access-title">@Lang.GetKey("not_access_title")</h1>

        <div class="not-access-message">
            @Lang.GetKey("not_access_message_1")<br />
            @Lang.GetKey("not_access_message_2")
        </div>

        <div class="not-access-actions">
            <a href="@Url.Action("Index", "Home")" class="btn-soft-primary">
                @Lang.GetKey("not_access_btn_home")
            </a>
        </div>

        <div class="not-access-note">
            @Lang.GetKey("not_access_note")
        </div>
    </div>
</div>