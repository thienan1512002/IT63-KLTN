@model Web.Models.ViewModels.Identity.UpdatePasswordViewModel
@using System.Globalization
@{
    Layout = null;
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    string currentFlag;
    string currentLanguageName;
    if (string.Equals(currentCulture, "en-US", StringComparison.OrdinalIgnoreCase))
    {
        currentFlag = Url.Content("~/images/flag/united-kingdom.png");
        currentLanguageName = "English";
    }
    else
    {
        currentFlag = Url.Content("~/images/flag/vietnam.png");
        currentLanguageName = "Vietnamese";
    }
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="~/images/branding/nam-viet-mark.png">
    <link rel="icon" type="image/png" href="~/images/branding/nam-viet-mark.png">
    <title>@Lang.GetKey("upd_pass_title") - @Lang.GetKey("brand_university")</title>
    <!-- Font Awesome Icons -->
    <script src="~/layout_assets/js/font-awesome.js"></script>
    <!-- CSS Files -->
    <link href="~/layout_assets/css/soft-ui-dashboard.min.css" rel="stylesheet" />
    <link href="~/css/university-brand.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/layout_assets/sweetalert2/dist/sweetalert2.css" rel="stylesheet" />
    <script src="~/layout_assets/sweetalert2/dist/sweetalert2.js"></script>
    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-weight: bold;
        }
        ::-webkit-input-placeholder {
            font-family: 'Be Vietnam Pro', sans-serif;
        }
        .lang-switcher {
            display: flex;
            justify-content: flex-end;
        }
        .password-wrapper {
            position: relative;
        }
        .password-wrapper .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            color: #6c757d;
            font-size: 1rem;
            line-height: 1;
        }
        .password-wrapper .toggle-password:focus {
            outline: none;
        }
    </style>
</head>

<body class="bg-gray-100 nvu-auth">
    <main class="main-content mt-0">
        <section>
            <div class="page-header min-vh-100">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-4 col-lg-5 col-md-7 d-flex flex-column mx-lg-0 mx-auto">
                            <div class="card">
                                <div class="card-header pb-0">
                                    <a class="nvu-auth-brand" href="/Account/Login" aria-label="@Lang.GetKey("brand_university")"><partial name="~/Views/Shared/Partials/_UniversityBrand.cshtml" /></a>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h4 class="font-weight-bolder mb-0">@Lang.GetKey("upd_pass_title")</h4>
                                        <!-- Language Switcher -->
                                        <div class="lang-switcher dropdown">
                                            <a class="btn btn-sm btn-white shadow-sm dropdown-toggle d-flex align-items-center gap-2"
                                               href="#" id="updPassLangDropdown" data-bs-toggle="dropdown" data-toggle="dropdown" role="button" aria-expanded="false"
                                               style="background:#fff; border:1px solid #dee2e6; border-radius:8px; padding:6px 12px; text-decoration:none; color:#344767;">
                                                <img src="@currentFlag" height="20" width="20" alt="@currentCulture" style="border-radius:3px;" />
                                                <span style="font-size:0.85rem; margin-left:6px;">@(currentLanguageName == "Vietnamese" ? "Tiếng Việt" : currentLanguageName)</span>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-right" aria-labelledby="updPassLangDropdown">
                                                <a class="dropdown-item d-flex align-items-center gap-2"
                                                   asp-action="SetLanguage" asp-controller="home" asp-route-culture="en-US" asp-route-returnUrl="@currentUrl">
                                                    <img src="~/images/flag/united-kingdom.png" height="20" width="20" style="border-radius:3px;" />
                                                    <span style="margin-left:6px;">English</span>
                                                </a>
                                                <a class="dropdown-item d-flex align-items-center gap-2"
                                                   asp-action="SetLanguage" asp-controller="home" asp-route-culture="vi-VN" asp-route-returnUrl="@currentUrl">
                                                    <img src="~/images/flag/vietnam.png" height="20" width="20" style="border-radius:3px;" />
                                                    <span style="margin-left:6px;">Tiếng Việt</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="mb-0 mt-1">@Lang.GetKey("upd_pass_subtitle")</p>
                                </div>
                                <div class="card-body">
                                    <form asp-action="UpdatePassword" asp-controller="Account" method="post">
                                        <div asp-validation-summary="All" class="text-danger" id="validation-summary"></div>
                                        <div class="mb-3">
                                            <label>@Lang.GetKey("upd_pass_username_label")</label>
                                            <input class="form-control form-control-lg" type="text"
                                                placeholder="@Lang.GetKey("upd_pass_username_label")" name="username" id="username" asp-for="UserName" readonly>
                                        </div>
                                        <div class="mb-3">
                                            <label>@Lang.GetKey("upd_pass_current_label")</label>
                                            <div class="password-wrapper">
                                                <input class="form-control form-control-lg" type="password"
                                                    id="currentPassInput"
                                                    placeholder="@Lang.GetKey("upd_pass_current_placeholder")"
                                                    aria-label="@Lang.GetKey("upd_pass_current_label")"
                                                    asp-for="CurrentPass" required
                                                    style="padding-right: 44px;">
                                                <button type="button" class="toggle-password" data-target="currentPassInput"
                                                        tabindex="-1" aria-label="Toggle password visibility">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label>@Lang.GetKey("upd_pass_new_label")</label>
                                            <div class="password-wrapper">
                                                <input class="form-control form-control-lg" type="password"
                                                    id="newPassInput"
                                                    placeholder="@Lang.GetKey("upd_pass_new_placeholder")"
                                                    aria-label="@Lang.GetKey("upd_pass_new_label")"
                                                    asp-for="NewPass" required
                                                    style="padding-right: 44px;">
                                                <button type="button" class="toggle-password" data-target="newPassInput"
                                                        tabindex="-1" aria-label="Toggle password visibility">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label>@Lang.GetKey("upd_pass_confirm_label")</label>
                                            <div class="password-wrapper">
                                                <input class="form-control form-control-lg" type="password"
                                                    id="confirmPassInput"
                                                    placeholder="@Lang.GetKey("upd_pass_confirm_placeholder")"
                                                    aria-label="@Lang.GetKey("upd_pass_confirm_label")"
                                                    asp-for="ConfirmPass" required
                                                    style="padding-right: 44px;">
                                                <button type="button" class="toggle-password" data-target="confirmPassInput"
                                                        tabindex="-1" aria-label="Toggle password visibility">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="text-center">
                                            <button type="submit"
                                                    class="btn btn-lg w-100 mt-4 mb-0"
                                                    >
                                                @Lang.GetKey("upd_pass_btn")
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <partial name="~/Views/Shared/Partials/_UniversityAuthHero.cshtml" />
                    </div>
                </div>
            </div>
        </section>
    </main>
    <script>
        (function () {
            // Password toggle
            document.querySelectorAll('.toggle-password').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-target');
                    var input = document.getElementById(targetId);
                    var icon = btn.querySelector('i');
                    if (!input || !icon) return;
                    var isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('fa-eye', !isPassword);
                    icon.classList.toggle('fa-eye-slash', isPassword);
                });
            });
            // Language dropdown toggle
            var langToggle = document.getElementById('updPassLangDropdown');
            if (langToggle) {
                langToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    var menu = langToggle.nextElementSibling;
                    if (menu) menu.classList.toggle('show');
                });
                document.addEventListener('click', function (e) {
                    if (!langToggle.contains(e.target)) {
                        var menu = langToggle.nextElementSibling;
                        if (menu) menu.classList.remove('show');
                    }
                });
            }
        })();
    </script>
</body>

</html>
