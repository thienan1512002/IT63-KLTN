@model Web.Models.ViewModels.Identity.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="~/images/branding/nam-viet-mark.png">
    <link rel="icon" type="image/png" href="~/images/branding/nam-viet-mark.png">
    <title>Forget Password - @Lang.GetKey("brand_university")</title>
    <!--     Fonts and icons     -->
    <link href="~/layout_assets/css/font-icons.css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
    <!-- Font Awesome Icons -->
    <script src="~/layout_assets/js/font-awesome.js"></script>
    <!-- CSS Files -->
    <link href="~/layout_assets/css/soft-ui-dashboard.min.css" rel="stylesheet" />
    <link href="~/css/university-brand.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="bg-gray-100 nvu-auth">
    <div class="container position-sticky z-index-sticky top-0">
        <div class="row">
            <div class="col-12">

            </div>
        </div>
    </div>
    <main class="main-content  mt-0">
        <section>
            <div class="page-header min-vh-100">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-4 col-lg-5 col-md-7 d-flex flex-column mx-lg-0 mx-auto">
                            <div class="card">
                                <div class="card-header pb-0 text-start">
                                    <a class="nvu-auth-brand" href="/Account/Login" aria-label="@Lang.GetKey("brand_university")"><partial name="~/Views/Shared/Partials/_UniversityBrand.cshtml" /></a>
                                    <h4 class="font-weight-bolder">Forget password</h4>
                                    <p class="mb-0">Enter your email to reset password</p>

                                </div>
                                <div class="card-body">
                                    <style>
                                        body {
                                        font-family: 'Be Vietnam Pro', sans-serif;
                                        font-weight: bold;
                                        }

                                        ::-webkit-input-placeholder {
                                        /* Chrome/Opera/Safari */
                                        font-family: 'Be Vietnam Pro', sans-serif;

                                        }
                                    </style>
                                    <form id="formForgetPass" asp-action="ForgotPassword" method="post">
                                        <div asp-validation-summary="All" class="text-danger" id="validation-summary">
                                        </div>
                                        <div class="mb-3">
                                            <label>Email</label>
                                            <input class="form-control form-control-lg" type="email" placeholder="Email"
                                                   aria-label="Password" asp-for="Email">
                                            <span class="text-danger"></span>
                                        </div>
                                        <div class="text-center">
                                            <button type="submit"
                                                    class="btn btn-lg btn-lg w-100 mt-4 mb-0">Reset
                                                Password</button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="card-footer text-center pt-0 px-lg-2 px-1">
                                        <p class="mb-4 text-sm mx-auto">
                                            Back to Login page
                                            <a href="/Account/Login">Click here</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <partial name="~/Views/Shared/Partials/_UniversityAuthHero.cshtml" />
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    @* <script src="~/template/plugins/jquery/jquery.min.js"></script> *@
    @* @await Component.InvokeAsync("NToastNotify") *@
</body>

</html>
