@{ ViewData["Title"] = "Vận hành sau phê duyệt"; }
<link rel="stylesheet" href="~/css/workflow/operations.css" asp-append-version="true" />
<div class="op-app" id="operationsApp" aria-busy="true">
    <header class="op-header"><div class="op-heading"><span class="op-feature"><i class="mdi mdi-calendar-multiple-check" aria-hidden="true"></i></span><div><p class="op-eyebrow">KẾT NỐI TỪ YÊU CẦU ĐẾN THỰC THI</p><h1>Vận hành sau phê duyệt</h1><p>Lịch nhân sự, điều phối xe và sổ phép từ dữ liệu đã được phê duyệt.</p></div></div><div class="op-header-actions"><a href="/RequestReports" class="op-button"><i class="mdi mdi-chart-bar" aria-hidden="true"></i> Báo cáo yêu cầu</a><button type="button" id="opSync" class="op-button" hidden><i class="mdi mdi-sync" aria-hidden="true"></i> Đồng bộ yêu cầu cũ</button></div></header>
    <div id="opError" class="op-message op-error" role="alert" hidden></div><div id="opNotice" class="op-message op-success" role="status" hidden></div>
    <nav class="op-tabs" role="tablist" aria-label="Phân hệ vận hành"><button type="button" id="opTabCalendar" role="tab" aria-controls="opCalendar" aria-selected="true" data-op-tab="calendar"><i class="mdi mdi-calendar-month-outline" aria-hidden="true"></i> Lịch làm việc</button><button type="button" id="opTabDispatch" role="tab" aria-controls="opDispatch" aria-selected="false" tabindex="-1" data-op-tab="dispatch"><i class="mdi mdi-car" aria-hidden="true"></i> Điều phối xe</button><button type="button" id="opTabLeave" role="tab" aria-controls="opLeave" aria-selected="false" tabindex="-1" data-op-tab="leave"><i class="mdi mdi-calendar-check" aria-hidden="true"></i> Sổ phép &amp; Phép tồn</button><button type="button" id="opTabSettings" role="tab" aria-controls="opSettings" aria-selected="false" tabindex="-1" data-op-tab="settings" hidden><i class="mdi mdi-tune" aria-hidden="true"></i> Thiết lập vận hành</button><button type="button" id="opExport" class="op-export"><i class="mdi mdi-download" aria-hidden="true"></i> Xuất CSV</button></nav>
    <section id="opCalendar" class="op-tab-panel" role="tabpanel" aria-labelledby="opTabCalendar">
        <div class="op-kpis" id="opCalendarKpis"></div>
        <div class="op-panel"><div class="op-panel-header"><div><h2>Lịch làm việc nhân sự</h2><p>Công tác, nghỉ phép, làm thêm và các chuyến xe đã duyệt.</p></div><div class="op-button-group"><button type="button" class="op-button is-active" id="opMonthView" aria-pressed="true">Tháng</button><button type="button" class="op-button" id="opAgendaView" aria-pressed="false">Danh sách</button><button type="button" class="op-button" id="opExportIcs" title="Tải lịch để nhập vào ứng dụng lịch">Tải lịch .ics</button></div></div>
            <div class="op-toolbar"><div class="op-period"><button type="button" class="op-icon-button" id="opPrevMonth" aria-label="Tháng trước">‹</button><label><span class="op-sr">Chọn tháng</span><input type="month" id="opMonth" /></label><button type="button" class="op-icon-button" id="opNextMonth" aria-label="Tháng sau">›</button><button type="button" class="op-button" id="opToday">Hôm nay</button></div><div class="op-filter"><label id="opCalendarEmployeeLabel">Nhân viên</label><div id="opCalendarEmployee"></div></div><label class="op-filter">Loại lịch<select id="opCalendarKind"><option value="">Tất cả loại lịch</option><option value="1">Công tác</option><option value="2">Nghỉ phép</option><option value="4">Lái xe</option><option value="3">Chuyến xe tham gia</option><option value="5">Làm thêm giờ</option></select></label></div>
            <div class="op-legend"><span><b class="op-dot op-trip"></b>Công tác</span><span><b class="op-dot op-leave"></b>Nghỉ phép</span><span><b class="op-dot op-drive"></b>Lái xe</span><span><b class="op-dot op-passenger"></b>Chuyến xe</span><span><b class="op-dot op-overtime"></b>Làm thêm</span><span class="op-legend-note">Giờ địa phương của cơ sở · UTC+7</span></div>
            <div id="opCalendarGrid" class="op-calendar-scroll" aria-live="polite"></div><div id="opAgenda" class="op-agenda" hidden></div>
        </div>
    </section>
    <section id="opDispatch" class="op-tab-panel" role="tabpanel" aria-labelledby="opTabDispatch" hidden>
        <div class="op-kpis" id="opDispatchKpis"></div><div class="op-panel"><div class="op-panel-header"><div><h2>Bảng điều phối xe</h2><p>Chỉ yêu cầu đã duyệt được đưa vào hàng chờ. Xe và tài xế trên form là thông tin đề xuất.</p></div></div><div class="op-toolbar"><label class="op-filter">Từ ngày<input id="opDispatchFrom" type="date" /></label><label class="op-filter">Đến ngày<input id="opDispatchTo" type="date" /></label><label class="op-filter">Trạng thái<select id="opDispatchStatus"><option value="">Tất cả trạng thái</option><option value="0">Chờ điều xe</option><option value="1">Đã phân công</option><option value="2">Đang thực hiện</option><option value="3">Hoàn thành</option><option value="4">Đã hủy chuyến</option></select></label><button class="op-button" type="button" id="opDispatchRefresh"><i class="mdi mdi-refresh" aria-hidden="true"></i> Tải lại</button><button class="op-button" type="button" id="opClearRequest" hidden>Bỏ lọc yêu cầu gốc</button></div><div class="op-grid-wrap" id="opDispatchGrid"></div><p class="op-footnote">Kiểm tra đồng thời xe, lịch tài xế, lịch nghỉ phép và công tác trước khi phân công. Hai chuyến liền kề được phép dùng chung tài xế và xe.</p></div>
    </section>
    <section id="opLeave" class="op-tab-panel" role="tabpanel" aria-labelledby="opTabLeave" hidden>
        <div class="op-panel"><div class="op-panel-header"><div><h2>Sổ phép &amp; Số dư khả dụng</h2><p>Phép còn lại = cấp trong năm + chuyển năm trước + điều chỉnh − đã dùng. Khả dụng trừ thêm số đang giữ chỗ.</p></div></div><div class="op-toolbar"><div class="op-filter op-grow"><label id="opLeaveEmployeeLabel">Nhân viên</label><div id="opLeaveEmployee"></div></div><label class="op-filter">Năm phép<input id="opLeaveYear" type="number" min="2000" max="2200" /></label><button type="button" class="op-button" id="opLeaveRefresh"><i class="mdi mdi-refresh" aria-hidden="true"></i> Tải lại sổ phép</button></div><div id="opLeaveCards" class="op-leave-cards"></div><p class="op-footnote">Hệ thống không tự suy đoán số ngày phép hoặc loại nghỉ được trừ phép. Số dư chưa cấp và chính sách chưa thiết lập được hiển thị riêng. Dữ liệu chưa đối soát cần được HR kiểm tra trước khi sử dụng số dư.</p></div>
    </section>
    <section id="opSettings" class="op-tab-panel" role="tabpanel" aria-labelledby="opTabSettings" hidden>
        <div class="op-panel"><div class="op-panel-header"><div><h2>Thiết lập theo cơ sở</h2><p>Phân quyền HR quản lý phép, điều phối viên quản lý xe và tài xế.</p></div></div><div class="op-toolbar"><label class="op-filter op-grow">Cơ sở<select id="opSite"></select></label><label class="op-filter">Năm ngoại lệ<input id="opSettingsYear" type="number" min="2000" max="2200" /></label><button type="button" id="opSettingsRefresh" class="op-button">Tải lại</button></div></div>
        <div id="opHRSettings" class="op-settings-grid" hidden>
            <section class="op-panel op-settings-card"><h3><i class="mdi mdi-calendar-week" aria-hidden="true"></i> Ngày làm việc trong tuần</h3><p>Áp dụng khi tính số ngày phép. Các yêu cầu đã gửi giữ nguyên số ngày đã ghi nhận.</p><form id="opWorkPolicyForm"><div id="opWorkDays" class="op-day-options"></div><button class="op-button op-primary" type="submit">Lưu lịch làm việc</button></form></section>
            <section class="op-panel op-settings-card"><h3><i class="mdi mdi-calendar-star" aria-hidden="true"></i> Ngày nghỉ / Ngày làm bù</h3><form id="opExceptionForm" class="op-form-stack"><label>Ngày<input type="date" name="date" required /></label><label>Tên / Lý do<input type="text" name="name" maxlength="200" required placeholder="Ví dụ: Ngày nghỉ của cơ sở" /></label><label>Cách tính<select name="isWorkingDay"><option value="false">Ngày nghỉ — không tính phép</option><option value="true">Ngày làm việc / làm bù</option></select></label><button class="op-button" type="submit">Thêm / Cập nhật ngày</button></form><div id="opExceptionList" class="op-resource-list"></div></section>
            <section class="op-panel op-settings-card op-wide"><h3><i class="mdi mdi-calendar-check" aria-hidden="true"></i> Cách tính từng loại nghỉ</h3><p>Chọn rõ loại nghỉ nào sử dụng hạn mức phép. Khi bật trừ phép, HR cần cấp sổ phép theo năm cho nhân viên.</p><div id="opLeaveRules" class="op-resource-list"></div></section>
        </div>
        <div id="opTransportSettings" class="op-settings-grid" hidden>
            <section class="op-panel op-settings-card"><h3><i class="mdi mdi-account-tie" aria-hidden="true"></i> Danh sách tài xế</h3><p>Chọn nhân viên từ master data để đưa vào danh sách điều phối.</p><form id="opDriverForm" class="op-form-stack"><label id="opDriverPersonLabel">Nhân viên</label><div id="opDriverPerson"></div><button class="op-button op-primary" type="submit">Đăng ký / Kích hoạt tài xế</button></form><div id="opDriverList" class="op-resource-list"></div></section>
            <section class="op-panel op-settings-card"><h3><i class="mdi mdi-car-multiple" aria-hidden="true"></i> Đội xe theo cơ sở</h3><p>Xe được lấy từ danh mục xe nhà trường. Sức chứa phải được khai báo trước khi điều phối.</p><form id="opFleetForm" class="op-form-stack"><label id="opFleetVehicleLabel">Xe trong danh mục</label><div id="opFleetVehicle"></div><button class="op-button op-primary" type="submit">Đăng ký / Kích hoạt xe</button></form><div id="opFleetList" class="op-resource-list"></div></section>
        </div>
    </section>
    <dialog id="opDialog" class="op-dialog" aria-labelledby="opDialogTitle"><form id="opDialogForm"><header><div><p class="op-eyebrow" id="opDialogEyebrow"></p><h2 id="opDialogTitle"></h2></div><button type="button" id="opDialogClose" class="op-icon-button" aria-label="Đóng">×</button></header><div class="op-dialog-content" id="opDialogBody"></div><div id="opDialogError" class="op-message op-error" role="alert" hidden></div><footer><button type="button" class="op-button" id="opDialogCancel">Đóng</button><button type="submit" class="op-button op-primary" id="opDialogSave">Lưu thay đổi</button></footer></form></dialog>
</div>
@section Scripts { <script src="~/js/workflow/operations.js" asp-append-version="true"></script> }
