<link rel="stylesheet" href="~/css/workflow/dashboard.css" asp-append-version="true" />
<div class="ap-dashboard" id="approvalDashboard" aria-busy="true">
    <header class="dash-header">
        <div class="dash-title"><span class="dash-title-icon"><i class="mdi mdi-chart-bar" aria-hidden="true"></i></span><div><h1>Dashboard Phê Duyệt Tự Động</h1><p>Theo dõi hiệu quả xử lý yêu cầu và tình trạng phê duyệt</p></div></div>
        <div class="dash-header-actions"><a class="dash-create" href="/Requests/Create"><i class="mdi mdi-plus" aria-hidden="true"></i> Tạo yêu cầu</a><button class="dash-icon-button" id="dashboardRefresh" type="button" title="Làm mới dữ liệu" aria-label="Làm mới dữ liệu"><i class="mdi mdi-refresh" aria-hidden="true"></i></button></div>
    </header>
    <div class="dash-toolbar">
        <div class="dash-period"><i class="mdi mdi-calendar-range" aria-hidden="true"></i><label class="dash-sr-only" for="dashboardPeriod">Khoảng thời gian</label><select id="dashboardPeriod"><option value="month">Tháng này</option><option value="last-month">Tháng trước</option><option value="30">30 ngày gần đây</option><option value="7">7 ngày gần đây</option><option value="custom">Tùy chọn</option></select><label class="dash-sr-only" for="dashboardFrom">Từ ngày</label><input type="date" id="dashboardFrom" /><span aria-hidden="true">—</span><label class="dash-sr-only" for="dashboardTo">Đến ngày</label><input type="date" id="dashboardTo" /></div>
        <label class="dash-search"><i class="mdi mdi-magnify" aria-hidden="true"></i><span class="dash-sr-only">Tìm kiếm yêu cầu</span><input id="dashboardSearch" type="search" maxlength="200" placeholder="Tìm tiêu đề, người tạo, mã phiếu..." /></label>
        <span class="dash-scope"><i class="mdi mdi-shield-check" aria-hidden="true"></i> @(User.IsInRole("SuperUser") ? "Toàn hệ thống" : "Yêu cầu bạn được phép xem")</span>
    </div>
    <div id="dashboardError" class="dash-error" role="alert" hidden></div>
    <div class="dash-kpis" aria-label="Chỉ số tổng quan">
        <article class="dash-kpi"><span class="dash-kpi-icon dash-blue"><i class="mdi mdi-file-document" aria-hidden="true"></i></span><div><h2>Tổng yêu cầu</h2><strong data-kpi="total">—</strong><div class="dash-delta" data-delta="total">Đang tải dữ liệu</div></div></article>
        <article class="dash-kpi"><span class="dash-kpi-icon dash-green"><i class="mdi mdi-check-circle" aria-hidden="true"></i></span><div><h2>Tự động phê duyệt</h2><strong data-kpi="automatic">—</strong><p class="dash-untracked" title="Chưa có dữ liệu ghi nhận phương thức tự động phê duyệt.">Chưa theo dõi</p></div></article>
        <article class="dash-kpi"><span class="dash-kpi-icon dash-amber"><i class="mdi mdi-clock-outline" aria-hidden="true"></i></span><div><h2>Đang chờ xử lý</h2><strong data-kpi="pending">—</strong><div class="dash-delta" data-delta="pending">Đang tải dữ liệu</div></div></article>
        <article class="dash-kpi"><span class="dash-kpi-icon dash-purple"><i class="mdi mdi-flash" aria-hidden="true"></i></span><div><h2>Tỷ lệ tự động hóa</h2><strong data-kpi="automation">—</strong><p class="dash-untracked">Chưa theo dõi</p></div></article>
        <article class="dash-kpi"><span class="dash-kpi-icon dash-blue"><i class="mdi mdi-clock-fast" aria-hidden="true"></i></span><div><h2>Xử lý trung bình</h2><strong data-kpi="average" title="Từ lần gửi gần nhất đến thời điểm hoàn thành, tính theo giờ lịch.">—</strong><div class="dash-delta" data-delta="average">Đang tải dữ liệu</div></div></article>
        <article class="dash-kpi"><span class="dash-kpi-icon dash-green"><i class="mdi mdi-shield-check" aria-hidden="true"></i></span><div><h2>SLA đúng hạn</h2><strong data-kpi="sla">—</strong><p class="dash-untracked" title="Cần cấu hình thời hạn SLA để đo tỷ lệ đúng hạn.">Chưa cấu hình</p></div></article>
    </div>
    <div class="dash-top-grid">
        <section class="dash-panel dash-trend-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-chart-areaspline" aria-hidden="true"></i> Xu hướng yêu cầu &amp; phê duyệt</h2><label><span class="dash-sr-only">Số tháng xu hướng</span><select id="dashboardTrendMonths"><option value="3">3 tháng gần đây</option><option value="6" selected>6 tháng gần đây</option><option value="12">12 tháng gần đây</option></select></label></div><div class="dash-chart-legend"><span><b class="dash-dot dash-bg-blue"></b>Tổng yêu cầu</span><span><b class="dash-dot dash-bg-green"></b>Đã hoàn thành</span><span><b class="dash-dot dash-bg-amber"></b>Đang xử lý</span></div><div id="dashboardTrend" class="dash-chart" aria-label="Xu hướng số yêu cầu theo tháng tạo"></div><p class="dash-chart-caption">Theo tháng tạo yêu cầu, đến ngày kết thúc đã chọn.</p></section>
        <section class="dash-panel dash-status-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-chart-donut" aria-hidden="true"></i> Tỷ lệ trạng thái</h2></div><div id="dashboardStatus" class="dash-donut" aria-label="Phân bố trạng thái yêu cầu"></div><div id="dashboardStatusLegend" class="dash-status-legend"></div></section>
        <section class="dash-panel dash-types-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-format-list-bulleted-type" aria-hidden="true"></i> Phân loại yêu cầu</h2><span class="dash-period-tag">Kỳ đã chọn</span></div><div id="dashboardTypes" class="dash-bars"></div></section>
    </div>
    <div class="dash-middle-grid">
        <section class="dash-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-chart-bar" aria-hidden="true"></i> Hiệu quả xử lý</h2><a class="dash-link" href="/RequestReports">Báo cáo <i class="mdi mdi-arrow-right" aria-hidden="true"></i></a></div><div class="dash-efficiency"><article><span class="dash-mini-icon dash-green"><i class="mdi mdi-check-decagram" aria-hidden="true"></i></span><h3>Tỷ lệ hoàn thành</h3><strong data-efficiency="completion">—</strong><p>trên tổng yêu cầu trong kỳ</p></article><article><span class="dash-mini-icon dash-blue"><i class="mdi mdi-account-check" aria-hidden="true"></i></span><h3>Lượt phê duyệt</h3><strong data-efficiency="approvals">—</strong><p>đã ghi nhận trong kỳ</p></article><article><span class="dash-mini-icon dash-purple"><i class="mdi mdi-sitemap" aria-hidden="true"></i></span><h3>Quy trình hoạt động</h3><strong data-efficiency="workflows">—</strong><p>theo cấu hình hiện tại</p></article></div><p class="dash-panel-note">Hiệu quả tự động hóa và thời gian tiết kiệm sẽ hiển thị khi có dữ liệu đo lường.</p></section>
        <section class="dash-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-office-building" aria-hidden="true"></i> Khối lượng theo bộ phận</h2><span class="dash-period-tag">Kỳ đã chọn</span></div><div id="dashboardDepartments" class="dash-bars"></div><p class="dash-chart-caption">Đơn vị tạo yêu cầu · tỷ lệ đã hoàn thành.</p></section>
        <section class="dash-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-account-star" aria-hidden="true"></i> Top người phê duyệt</h2><span class="dash-period-tag">Lượt duyệt</span></div><ol id="dashboardApprovers" class="dash-approvers"></ol></section>
    </div>
    <div class="dash-bottom-grid">
        <section class="dash-panel dash-attention-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-alert-circle dash-alert-icon" aria-hidden="true"></i> Yêu cầu cần chú ý</h2><a class="dash-link" href="/RequestReports?status=1">Xem tất cả <i class="mdi mdi-arrow-right" aria-hidden="true"></i></a></div><div class="dash-table-scroll"><table class="dash-table"><thead><tr><th>Mã phiếu</th><th>Loại yêu cầu</th><th>Người tạo</th><th>Trạng thái</th><th>Ưu tiên</th><th>Từ lần gửi</th><th></th></tr></thead><tbody id="dashboardAttention"></tbody></table></div></section>
        <section class="dash-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-settings" aria-hidden="true"></i> Quy trình phê duyệt</h2>@if (User.IsInRole("SuperUser")) { <a class="dash-link" href="/Workflows">Quản lý <i class="mdi mdi-arrow-right" aria-hidden="true"></i></a> }</div><div class="dash-table-scroll"><table class="dash-table dash-workflow-table"><thead><tr><th>Quy trình / Áp dụng cho</th><th>Bước</th><th>Trạng thái</th></tr></thead><tbody id="dashboardWorkflows"></tbody></table></div><p class="dash-chart-caption">Trạng thái hiện tại của các quy trình trong phạm vi xem.</p></section>
        <section class="dash-panel"><div class="dash-panel-heading"><h2><i class="mdi mdi-pulse" aria-hidden="true"></i> Hoạt động gần đây</h2></div><ol id="dashboardActivities" class="dash-activities"></ol></section>
    </div>
    <footer class="dash-footer"><span>Số liệu theo thời gian tạo yêu cầu; hoạt động và lượt duyệt được ghi nhận trong cùng kỳ.</span><span id="dashboardUpdated" aria-live="polite">Đang tải dữ liệu...</span></footer>
</div>
