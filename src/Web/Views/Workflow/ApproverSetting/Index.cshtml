            deleteConfirm:          '@Html.Raw(Lang.GetKey("approver_delete_confirm"))',
            deleted:                '@Html.Raw(Lang.GetKey("approver_deleted"))',
            deleteFailed:           '@Html.Raw(Lang.GetKey("approver_delete_failed"))',
            updated:                '@Html.Raw(Lang.GetKey("approver_updated"))',
