            formcodeRequired:       '@Html.Raw(Lang.GetKey("approver_formcode_required"))',
            titleRequired:          '@Html.Raw(Lang.GetKey("approver_title_required"))',
            displayTitleRequired:   '@Html.Raw(Lang.GetKey("approver_display_title_required"))',
            approverRequired:       '@Html.Raw(Lang.GetKey("approver_approver_required"))',
        };
    </script>
    <script type="module" src="~/js/workflow/approver-setting/approver-setting.js" asp-append-version="true"></script>
}
